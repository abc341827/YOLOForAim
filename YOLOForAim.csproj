<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TensorRtRuntimeSelectorDefault>auto</TensorRtRuntimeSelectorDefault>
    <TensorRtNativeProject>native\TensorRtNative\TensorRtNative.vcxproj</TensorRtNativeProject>
  </PropertyGroup>
  <Import Project="native\TensorRtNative\TensorRtNative.local.props" Condition="Exists('native\TensorRtNative\TensorRtNative.local.props')" />
  <PropertyGroup>
    <TensorRtMajor Condition="'$(TensorRtMajor)'=='' and Exists('C:\SDK\TensorRT-11.0.0.114')">11</TensorRtMajor>
    <TensorRtRoot Condition="'$(TensorRtRoot)'=='' and Exists('C:\SDK\TensorRT-11.0.0.114')">C:\SDK\TensorRT-11.0.0.114</TensorRtRoot>
    <CudaRoot Condition="'$(CudaRoot)'==''">$(CUDA_PATH)</CudaRoot>
    <TensorRtConfiguredRuntimeDir Condition="'$(TensorRtMajor)'=='11' and $([System.String]::Copy('$(CudaRoot)').Contains('\v13.'))">runtimes\tensorrt11-cuda13</TensorRtConfiguredRuntimeDir>
    <TensorRtConfiguredRuntimeDir Condition="'$(TensorRtConfiguredRuntimeDir)'=='' and '$(TensorRtMajor)'=='11'">runtimes\tensorrt11-cuda12</TensorRtConfiguredRuntimeDir>
    <TensorRtConfiguredRuntimeDir Condition="'$(TensorRtConfiguredRuntimeDir)'=='' and '$(TensorRtMajor)'=='10'">runtimes\tensorrt10-cuda12</TensorRtConfiguredRuntimeDir>
    <TensorRtNativeOutputDll>native\TensorRtNative\bin\$(Configuration)\native\TensorRtNative.dll</TensorRtNativeOutputDll>
    <TensorRtCanBuildNative Condition="'$(MSBuildRuntimeType)'!='Core' and '$(Configuration)'=='Release' and Exists('$(TensorRtNativeProject)') and Exists('$(TensorRtRoot)\lib\nvinfer_$(TensorRtMajor).lib') and Exists('$(TensorRtRoot)\lib\nvinfer_plugin_$(TensorRtMajor).lib') and Exists('$(CudaRoot)\lib\x64\cudart.lib')">true</TensorRtCanBuildNative>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="native\**" />
    <EmbeddedResource Remove="native\**" />
    <None Remove="native\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.18.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.18.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes\**\*.dll" Condition="Exists('runtimes')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tensorrt-runtime.txt" Condition="Exists('tensorrt-runtime.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="cudart64_12.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="dawn.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Models\dawn2.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>dawn2.onnx</TargetPath>
    </None>
    <None Update="dawn01.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\TensorRT\dawn2.engine">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>dawn2.engine</TargetPath>
    </None>
    <None Update="Assets\TensorRT\nvinfer_10.lib">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>nvinfer_10.lib</TargetPath>
    </None>
    <None Update="Assets\TensorRT\nvinfer_plugin_10.lib">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>nvinfer_plugin_10.lib</TargetPath>
    </None>
    <None Include="native\TensorRtNative\TensorRtNative.local.props" />
    <None Include="native\TensorRtNative\TensorRtNative.local.props.example" />
    <None Include="TensorRtNative.dll" Condition="Exists('TensorRtNative.dll')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildConfiguredTensorRtNative" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(TensorRtCanBuildNative)'=='true'">
    <MSBuild Projects="$(TensorRtNativeProject)" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64;TensorRtMajor=$(TensorRtMajor);TensorRtRoot=$(TensorRtRoot);CudaRoot=$(CudaRoot)" />
  </Target>

  <Target Name="CopyConfiguredTensorRtRuntime" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(TensorRtCanBuildNative)'=='true' and Exists('$(TensorRtNativeOutputDll)') and '$(TensorRtConfiguredRuntimeDir)'!=''">
    <ItemGroup>
      <_ConfiguredTensorRtRuntimeFiles Include="$(TensorRtNativeOutputDll)" />
      <_ConfiguredTensorRtRuntimeFiles Include="$(TensorRtRoot)\bin\nvinfer_$(TensorRtMajor).dll" Condition="Exists('$(TensorRtRoot)\bin\nvinfer_$(TensorRtMajor).dll')" />
      <_ConfiguredTensorRtRuntimeFiles Include="$(TensorRtRoot)\bin\nvinfer_plugin_$(TensorRtMajor).dll" Condition="Exists('$(TensorRtRoot)\bin\nvinfer_plugin_$(TensorRtMajor).dll')" />
      <_ConfiguredTensorRtRuntimeFiles Include="$(CudaRoot)\bin\cudart64_13.dll" Condition="Exists('$(CudaRoot)\bin\cudart64_13.dll')" />
      <_ConfiguredTensorRtRuntimeFiles Include="$(CudaRoot)\bin\x64\cudart64_13.dll" Condition="Exists('$(CudaRoot)\bin\x64\cudart64_13.dll')" />
      <_ConfiguredTensorRtRuntimeFiles Include="$(CudaRoot)\bin\cudart64_12.dll" Condition="Exists('$(CudaRoot)\bin\cudart64_12.dll')" />
      <_ConfiguredTensorRtRuntimeFiles Include="$(CudaRoot)\bin\x64\cudart64_12.dll" Condition="Exists('$(CudaRoot)\bin\x64\cudart64_12.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)$(TensorRtConfiguredRuntimeDir)" />
    <Copy SourceFiles="@(_ConfiguredTensorRtRuntimeFiles)" DestinationFolder="$(OutDir)$(TensorRtConfiguredRuntimeDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="WriteTensorRtRuntimeSelector" AfterTargets="CopyFilesToOutputDirectory">
    <MakeDir Directories="$(OutDir)" />
    <WriteLinesToFile File="$(OutDir)tensorrt-runtime.txt" Lines="$(TensorRtRuntimeSelectorDefault)" Overwrite="true" Condition="!Exists('$(OutDir)tensorrt-runtime.txt')" />
  </Target>
</Project>
